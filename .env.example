# Database — SQLite file locally; on Vercel the Neon integration sets DATABASE_URL (postgres://…)
DATABASE_URL=file:./rowville-eagles.db
# Long random string (Vercel: generate one, never reuse)
PAYLOAD_SECRET=replace-with-a-long-random-string
# Public URL of the site (Vercel falls back to the project domain automatically)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Uploaded images — set automatically by the Vercel Blob integration
BLOB_READ_WRITE_TOKEN=

# First-deploy content (Vercel): fill an empty database with sample content + create the first admin
SEED_SAMPLE_CONTENT=false
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Email (Resend) — without a key, emails are saved to ./.outbox locally and not sent
RESEND_API_KEY=
EMAIL_DEFAULT_FROM_ADDRESS=hello@rowvilleeagles.com.au
EMAIL_FROM_CLUB=Rowville Eagles FC <hello@rowvilleeagles.com.au>
EMAIL_FROM_ACADEMY=Rowville Foundation Academy <academy@rowvilleeagles.com.au>

# Local dev only: set true to test checkout without Stripe keys (ignored in production)
PAYMENTS_SIMULATE=false

# Stripe — two separate accounts (see README)
STRIPE_SECRET_KEY_CLUB=
STRIPE_WEBHOOK_SECRET_CLUB=
STRIPE_SECRET_KEY_ACADEMY=
STRIPE_WEBHOOK_SECRET_ACADEMY=
